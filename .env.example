# Copy to Vercel > Project > Settings > Environment Variables. All are optional: without them the site runs in demo mode.
# MUDA Pay (mobile money, MTN and Airtel). Muda dashboard > Settings > API keys (collections role).
MUDA_API_KEY=
MUDA_SECRET_KEY=
# Optional: force the UGX mobile money PULL product id
MUDA_PRODUCT_UGX=
# Crypto (NOWPayments API, white-label: customers never see the name). Set by: bash setup-crypto.sh
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# true = sandbox (api-sandbox), false = live
NOWPAYMENTS_SANDBOX=true
# Neon Postgres for crypto orders and the cached exchange rate
DATABASE_URL=
# Optional: smallest crypto order in USD (default 3)
CRYPTO_MIN_USD=
# Fallback shillings per US dollar. The live rate is used when the free rate API answers.
UGX_PER_USD=
# Long-term memory for orders and forms (Supabase free tier). Use the service role key (server only).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional: a Telegram message to the café for each paid order and each form.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
